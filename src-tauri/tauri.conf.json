{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fermata",
  "version": "0.2.0",
  "identifier": "com.matthewfernando.fermata",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Fermata",
        "width": 470,
        "height": 310,
        "decorations": false,
        "resizable": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "-"
}
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCRDFENTVDRDg5MDRBQUUKUldTdVNwRFlYTlhSV3dUdGl5NDl3c3RwQ2tqc1VVSndkY3FqT1Z4T3FLcU5Hc0ZDdmJiWTFBZEYK",
      "endpoints": [
        "https://github.com/matthew-fernando/Fermata/releases/latest/download/latest.json"
      ]
    }
  }
}
